# Copy to .env and replace every value marked CHANGE_ME.
MONGO_URL=mongodb://localhost:27017
DB_NAME=typinger
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
CORS_ORIGINS=http://localhost:3000

# Secure, HttpOnly admin session cookie.
# Production (HTTPS): ADMIN_COOKIE_SECURE=true and ideally SameSite=lax.
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAMESITE=lax
ADMIN_SESSION_MINUTES=480
ADMIN_SESSION_IDLE_MINUTES=120
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15

# Optional first-run bootstrap. Only used when no administrator exists at all.
# Prefer: python scripts/create_admin.py --email you@example.com --role super_admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
