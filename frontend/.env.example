# Backend API origin, without a trailing slash and without /api.
# Set this for production. The Cloudflare Worker deliberately answers /api
# itself with a 404, so an empty value only works in local development with a
# separate same-origin proxy in front of the API.
REACT_APP_BACKEND_URL=

# Optional Google Analytics measurement ID. Analytics loads only after consent.
REACT_APP_GA_ID=

# Optional Google Search Console verification token.
REACT_APP_GSC_VERIFICATION=

# Google AdSense
# The publisher ID below must match public/ads.txt and the verification meta tag.
REACT_APP_ADSENSE_PUBLISHER_ID=ca-pub-4755033920004677

# Ads stay off unless this is explicitly true AND a CMP and real slot IDs are
# configured. Keep false until the owner has completed the checklist.
REACT_APP_ADSENSE_ENABLED=false

# "google" for Google's consent message, "external" for a Google-certified CMP.
# Empty means ad requests stay disabled.
REACT_APP_CMP_PROVIDER=

# Ad unit slot IDs. Leave a value empty until that unit exists in AdSense.
# Empty or non-numeric values render no ad at all in production.
# Only editorial and completed-result placements are currently requested.
REACT_APP_ADSENSE_SLOT_HOMEPAGE_AFTER_TEST=
REACT_APP_ADSENSE_SLOT_HOMEPAGE_CONTENT=
REACT_APP_ADSENSE_SLOT_TYPING_AFTER_RESULT=
REACT_APP_ADSENSE_SLOT_PRACTICE_AFTER_RESULT=
REACT_APP_ADSENSE_SLOT_LESSON_AFTER_COMPLETION=
REACT_APP_ADSENSE_SLOT_BLOG_INDEX_INLINE=
REACT_APP_ADSENSE_SLOT_ARTICLE_MID=
REACT_APP_ADSENSE_SLOT_ARTICLE_LOWER=
REACT_APP_ADSENSE_SLOT_DESKTOP_RAIL=
REACT_APP_ADSENSE_SLOT_EXAM_AFTER_RESULT=
